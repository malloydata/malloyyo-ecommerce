##! experimental.access_modifiers
##! experimental.givens

import "../ecommerce.malloy"

# artifact { title="Category Seasonality" }
#" Category seasonality — each category's calendar-month sales as a share of its OWN annual total, so a small category's rhythm reads as clearly as a giant's. Warm months over-index, cool months under-index. Filter by brand, department, or time period.
query: seasonality is order_items -> {
  where:
    inventory_items.product_brand ~ $BRAND,
    inventory_items.product_department ~ $DEPARTMENT,
    created_at ~ $PERIOD
  group_by:
    category is inventory_items.product_category
    month_num is month(created_at)
    month_name is month(created_at) ?
      pick 'Jan' when 1 pick 'Feb' when 2 pick 'Mar' when 3
      pick 'Apr' when 4 pick 'May' when 5 pick 'Jun' when 6
      pick 'Jul' when 7 pick 'Aug' when 8 pick 'Sep' when 9
      pick 'Oct' when 10 pick 'Nov' when 11 else 'Dec'
  aggregate:
    month_sales is total_sales
    category_total is all(total_sales, category)
    seasonal_share is total_sales / all(total_sales, category)
  order_by: category, month_num
}
